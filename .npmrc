# This project pins a Next.js prerelease (16.3.0-preview.x). Semver says a
# prerelease doesn't satisfy a plain range, so every package declaring
# `next` as a peer (e.g. @vercel/analytics, @vercel/speed-insights) fails
# resolution with ERESOLVE. Vercel reads this file during its build, so
# keeping it here means local installs and deploys behave identically.
legacy-peer-deps=true
