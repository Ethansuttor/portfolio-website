# Copy to .env.local (git-ignored) and fill in.

# Required for the contact form. Get one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Resend only accepts senders on a domain you have verified, so leave
# this unset until ethansuttor.com is verified — the route falls back to
# Resend's shared onboarding@resend.dev sender.
# CONTACT_FROM_EMAIL="Portfolio Contact <hello@ethansuttor.com>"

# Optional. Overrides where contact-form mail lands; defaults to CONTACT_INBOX
# in src/lib/site.ts. Only needed if you want a different inbox, or if you fall
# back to the onboarding sender above — that sender delivers *only* to the
# address owning the API key and rejects anything else with a 403.
# CONTACT_TO_EMAIL=e0sutt03@louisville.edu
